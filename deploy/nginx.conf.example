# Replace the names, ports and certificate paths. See docs/guides/reverse-proxy.md.
map $http_upgrade $tolktak_connection {
    default upgrade;
    ''      close;
}

server {
    listen 443 ssl;   # adapt to how your nginx terminates TLS
    http2 on;
    server_name talk.example.com;
    ssl_certificate     /etc/ssl/tolktak/talk.example.com.crt;
    ssl_certificate_key /etc/ssl/tolktak/talk.example.com.key;
    client_max_body_size 60m; # TOLKTAK_MAX_UPLOAD_MB plus overhead
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $tolktak_connection;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s; # server pings every 25 s
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name lk.example.com;
    ssl_certificate     /etc/ssl/tolktak/lk.example.com.crt;
    ssl_certificate_key /etc/ssl/tolktak/lk.example.com.key;
    location / {
        proxy_pass http://127.0.0.1:7880; # media goes over UDP directly
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $tolktak_connection;
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }
}
