# Copied to .env by init.sh, which also fills in the addresses and random keys.
# Reference: docs/operations/configuration.md

TOLKTAK_SERVER_NAME=TolkTak
# open | invite | closed. The first registered account becomes the administrator.
TOLKTAK_REGISTRATION=invite
TOLKTAK_MAX_UPLOAD_MB=50
# Total size of the files one user can keep, in MB. 0 for no limit.
TOLKTAK_USER_QUOTA_MB=2048
# Optional link shown on the server's website for downloading the desktop app.
TOLKTAK_CLIENT_DOWNLOAD_URL=https://github.com/D4eNst/tolktak/releases/latest

# Server image tag used by docker compose: latest, or a release such as 0.1.0.
TOLKTAK_VERSION=latest

# Address the apps use to reach LiveKit. Written by init.sh.
LIVEKIT_PUBLIC_URL=wss://lk.example.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# 127.0.0.1 behind a reverse proxy (HTTPS); 0.0.0.0 to serve plain HTTP directly.
TOLKTAK_BIND=127.0.0.1
LIVEKIT_BIND=127.0.0.1
# 1 when the server is reachable only through a reverse proxy: rate limits then use X-Forwarded-For.
TOLKTAK_TRUST_PROXY=1

# Ports. Change them when another service already uses one.
TOLKTAK_PORT=8080
LIVEKIT_PORT=7880
RTC_TCP_PORT=7881
RTC_UDP_START=50000
RTC_UDP_END=60000
TURN_UDP_PORT=3478
TURN_RELAY_START=30000
TURN_RELAY_END=40000
