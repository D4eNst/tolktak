# Generated by init.sh. Open TCP ${RTC_TCP_PORT}, UDP ${RTC_UDP_START}-${RTC_UDP_END}, UDP ${TURN_UDP_PORT},
# UDP ${TURN_RELAY_START}-${TURN_RELAY_END}, and HTTPS on the proxy or TCP ${LIVEKIT_PORT} without one.
port: ${LIVEKIT_PORT}
bind_addresses: ["${LIVEKIT_BIND}"]
rtc:
  tcp_port: ${RTC_TCP_PORT}
  port_range_start: ${RTC_UDP_START}
  port_range_end: ${RTC_UDP_END}
  use_external_ip: true
  # With Docker networks or a VPN on the host, offer only the public interface:
  # interfaces:
  #   includes: [eth0]
turn:
  enabled: true
  domain: ${LIVEKIT_DOMAIN}
  udp_port: ${TURN_UDP_PORT}
  relay_range_start: ${TURN_RELAY_START}
  relay_range_end: ${TURN_RELAY_END}
keys:
  ${LIVEKIT_API_KEY}: ${LIVEKIT_API_SECRET}
webhook:
  api_key: ${LIVEKIT_API_KEY}
  urls:
    - http://127.0.0.1:${TOLKTAK_PORT}/api/v1/livekit/webhook
room:
  empty_timeout: 60
  # Adds H.264 42001f: Chromium encodes it on the GPU, the default 42e01f only in software.
  enabled_codecs:
    - mime: audio/opus
    - mime: audio/red
    - mime: audio/PCMU
    - mime: audio/PCMA
    - mime: video/H264
      fmtp_line: level-asymmetry-allowed=1;packetization-mode=1;profile-level-id=42001f
    - mime: video/H264
    - mime: video/VP8
    - mime: video/VP9
    - mime: video/AV1
    - mime: video/H265
    - mime: video/rtx
logging:
  level: info
