# Saved as .env next to compose.yaml. Set the domain, then append the secrets with the
# command from docs/install/compose.md.

# The address participants use. Its DNS record must point at this server before the
# first start: Caddy then gets the HTTPS certificate on its own.
TOLKTAK_DOMAIN=chat.example.com

# Server image tag: latest, or a release such as 0.2.0.
TOLKTAK_VERSION=latest

TOLKTAK_SERVER_NAME=TolkTak
# open | invite | closed. The first registered account becomes the administrator.
TOLKTAK_REGISTRATION=invite
TOLKTAK_MAX_UPLOAD_MB=50
# Total size of the files one user can keep, in MB. 0 for no limit.
TOLKTAK_USER_QUOTA_MB=2048
# Optional link shown on the server's website for downloading the desktop app.
TOLKTAK_CLIENT_DOWNLOAD_URL=https://github.com/D4eNst/tolktak/releases/latest

# Bundled services. Remove one from the list to use your own instead:
#   livekit:  set LIVEKIT_PUBLIC_URL, LIVEKIT_INTERNAL_URL and the key (docs/operations/configuration.md)
#   postgres: set TOLKTAK_DATABASE_URL (docs/guides/postgres.md)
#   garage:   set TOLKTAK_S3_* (docs/guides/s3.md), or TOLKTAK_S3_BUCKET= to keep files on disk
#   caddy:    use your reverse proxy (docs/guides/reverse-proxy.md)
COMPOSE_PROFILES=livekit,postgres,garage,caddy

# TOLKTAK_DATABASE_URL=postgres://tolktak:password@db.example.com:5432/tolktak
# TOLKTAK_S3_BUCKET=tolktak
# TOLKTAK_S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
# TOLKTAK_S3_REGION=auto
# TOLKTAK_S3_ACCESS_KEY=
# TOLKTAK_S3_SECRET_KEY=

# Secrets
